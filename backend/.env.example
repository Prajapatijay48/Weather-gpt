# Weather-GPT Backend Configuration
# Copy this file to .env and provide your credentials

# OpenAI API Key for context-aware conversational forecasting
OPENAI_API_KEY=

# Optional Weather API Key (Open-Meteo is default & keyless; set if using OpenWeatherMap or IMD)
WEATHER_API_KEY=

# PostgreSQL / Supabase Database URL (e.g. postgresql://postgres:password@localhost:5432/weathergpt)
# If left blank or unreachable, automatically falls back to local SQLite database: sqlite:///weather_gpt.db
DATABASE_URL=

# Redis Cache URL (e.g. redis://localhost:6379/0 or Upstash Redis URL)
# If left blank or unreachable, automatically falls back to in-memory TTL cache
REDIS_URL=

# Cache Time-To-Live in seconds (Default: 900 seconds = 15 minutes)
CACHE_TTL_SECONDS=900

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Server Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
